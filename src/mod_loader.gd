func _ready() -> void:
	var dir = DirAccess.open("user://")
	if dir.dir_exists("user://mods"):
		print("Йоу папка модов существует")
	else:
		dir.make_dir("user://mods")
		
	dir.change_dir("user://mods")
	for mod in dir.get_files():
		print(mod)
		if mod.ends_with(".pck"):
			print("[COOLSKELETONMODLOADER] Попытка загрузки мода %s." % mod)
			var success = ProjectSettings.load_resource_pack("user://mods/" + mod)
			if success:
				print("[COOLSKELETONMODLOADER] Загружен мод %s." % mod)
				loadedMods.append(mod)
			else:
				printerr("[COOLSKELETONMODLOADER] Мод %s не загрузился." % mod)
		else:
			print("[COOLSKELETONMODLOADER] Файл %s не является .pck файлом. Пропуск." % mod)
			
		


